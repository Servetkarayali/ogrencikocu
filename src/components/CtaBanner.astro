---
interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Çocuğunuz için doğru adımı birlikte belirleyelim',
  text = '30 dakikalık ücretsiz tanışma görüşmesinde durumu dinliyor, size özel ilk önerileri paylaşıyorum. Hiçbir yükümlülük yok.',
} = Astro.props;
---

<section class="cta">
  <div class="container inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="btn-row">
      <a href="/randevu" class="btn btn-primary">Ücretsiz 30 dk Görüşme Al</a>
      <a href="/ucretsiz-rehber" class="btn btn-ghost">Ücretsiz Rehberi İndir</a>
    </div>
  </div>
</section>

<style>
  .cta { background: var(--c-primary); color: #fff; padding: 64px 0; }
  .inner { display: grid; grid-template-columns: 1.4fr 1fr; gap: 32px; align-items: center; }
  h2 { color: #fff; }
  p { color: #d6e6e3; margin: 0; font-size: 1.1rem; }
  .btn-row { justify-content: flex-end; }
  .btn-ghost { border-color: rgba(255, 255, 255, 0.6); color: #fff; background: transparent; }
  .btn-ghost:hover { background: #fff; color: var(--c-primary); }
  @media (max-width: 820px) {
    .inner { grid-template-columns: 1fr; }
    .btn-row { justify-content: flex-start; }
  }
</style>
