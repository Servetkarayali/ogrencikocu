      <h1>Bu sayfa bulunamadı</h1>
      <p class="muted">Aradığınız sayfa taşınmış ya da hiç var olmamış olabilir.</p>
      <div class="btn-row" style="justify-content:center">
        <a href="/" class="btn btn-primary">Ana Sayfaya Dön</a>
        <a href="/testler" class="btn btn-secondary">Ücretsiz Testler</a>
      </div>
    </div>
  </section>
</BaseLayout>
