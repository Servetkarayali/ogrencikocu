---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
const l = site.legal;
---

<BaseLayout title="Impressum">
  <section class="section">
    <div class="container narrow prose">
      <h1>Impressum</h1>
      <p class="small muted">Angaben gemäß § 5 DDG</p>

      <p>
        {l.fullName}<br />
        Online-Schülercoaching<br />
        {l.street}<br />
        {l.city}<br />
        {l.country}
      </p>

      <h2>Kontakt</h2>
      <p>
        {l.phone && <>Telefon: {l.phone}<br /></>}
        E-Mail: <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>

      {l.vatId && (
        <>
          <h2>Umsatzsteuer-ID</h2>
          <p>Umsatzsteuer-Identifikationsnummer gemäß § 27a UStG: {l.vatId}</p>
        </>
      )}

      <h2>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
      <p>{l.fullName}, Anschrift wie oben</p>

      <h2>Verbraucherstreitbeilegung</h2>
      <p>Wir sind nicht bereit oder verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.</p>
    </div>
  </section>
</BaseLayout>
